local stages={}

function scan()
    stages={}

    local seen={}

    local function grab(c)
        for _,o in ipairs(c:GetDescendants()) do
            local n=tonumber(o.Name)

            if n and n>=1 and n<=41 and not seen[n] then
                local p

                if o:IsA("BasePart") then
                    p=o
                elseif o:IsA("Model") then
                    p=o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart",true)
                end

                if p then
                    stages[n]=p
                    seen[n]=true
                end
            end
        end
    end

    local found={}

    for _,o in ipairs(workspace:GetDescendants()) do
        local nm=o.Name:lower()

        if (o:IsA("Folder") or o:IsA("Model")) and nm:find("stage") then
            table.insert(found,o)
        end
    end

    if #found>0 then
        for _,c in ipairs(found) do
            grab(c)
        end
    end

    if #stages<5 then
        stages={}
        seen={}
        grab(workspace)
    end

    local c=0

    for _ in pairs(stages) do
        c=c+1
    end

    setStatus(string.format("Found %d/41 stages.",c))
end

local running=false

function runLoop()
    if running then return end

    running=true
    scan()

    local order={}

    for i=Config.StartStage,Config.EndStage do
        table.insert(order,i)
    end

    local total=#order

    while Config.TPAllStages do
        for idx,n in ipairs(order) do
            if not Config.TPAllStages then
                break
            end

            local part=stages[n]
            local char=LocalPlayer.Character
            local hrp=char and char:FindFirstChild("HumanoidRootPart")

            if part and hrp then
                hrp.CFrame=CFrame.new(
                    part.Position+Vector3.new(0,5,0)
                )

                setStatus(string.format(
                    "Stage %d  (%d/%d)",
                    n,
                    idx,
                    total
                ))

                if idx==total and Config.RestartTP then
                    task.wait(math.max(Config.Delay,0.05))

                    local c2=LocalPlayer.Character
                    local h2=c2 and c2:FindFirstChild("HumanoidRootPart")

                    if h2 then
                        h2.CFrame=CFrame.new(RESTART_POS)
                    end

                    for s=Config.RestartWait,1,-1 do
                        if not Config.TPAllStages then
                            break
                        end

                        setStatus(string.format(
                            "Restart pos — continuing in %ds...",
                            s
                        ))

                        task.wait(1)
                    end
                end
            end

            if Config.Delay==0 then
                RunService.Heartbeat:Wait()
            else
                task.wait(Config.Delay)
            end
        end

        if not (Config.LoopMode or Config.RestartTP) then
            break
        end

        task.wait(0.4)
    end

    running=false
    Config.TPAllStages=false
    ToggleRef.set(false)
    setStatus("Idle.")
end

local COOLDOWN_KEYS={
    "cooldown",
    "cd",
    "delay",
    "recharge",
    "rate",
    "wait"
}

local function matchesCooldown(name)
    local n=name:lower()

    for _,k in ipairs(COOLDOWN_KEYS) do
        if n==k or n:find(k) then
            return true
        end
    end

    return false
end

local function zeroCooldowns(tool)
    if not tool or not tool:IsA("Tool") then return end

    for _,obj in ipairs(tool:GetDescendants()) do
        if obj:IsA("NumberValue") or obj:IsA("IntValue") then
            if matchesCooldown(obj.Name) then
                obj.Value=0
            end
        elseif obj:IsA("StringValue") then
            if matchesCooldown(obj.Name) then
                obj.Value="0"
            end
        end
    end

    for _,attr in ipairs(tool:GetAttributes()) do
        if matchesCooldown(attr) then
            pcall(function()
                tool:SetAttribute(attr,0)
            end)
        end
    end
end

