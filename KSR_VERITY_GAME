local function makePage(name,order)
    local btn=Instance.new("TextButton")
    btn.Size=UDim2.new(1,0,0,26)
    btn.BackgroundColor3=BG_ROW
    btn.Text=name
    btn.TextColor3=TXT_DIM
    btn.Font=Enum.Font.GothamMedium
    btn.TextSize=11
    btn.BorderSizePixel=0
    btn.LayoutOrder=order or 1
    btn.AutoButtonColor=false
    btn.Parent=Sidebar
    Instance.new("UICorner",btn).CornerRadius=UDim.new(0,5)

    local page=Instance.new("ScrollingFrame")
    page.Size=UDim2.new(1,-14,1,-14)
    page.Position=UDim2.new(0,7,0,7)
    page.BackgroundTransparency=1
    page.BorderSizePixel=0
    page.ScrollBarThickness=3
    page.ScrollBarImageColor3=ACCENT
    page.CanvasSize=UDim2.new(0,0,0,0)
    page.AutomaticCanvasSize=Enum.AutomaticSize.Y
    page.Visible=false
    page.Parent=Content

    local L=Instance.new("UIListLayout")
    L.Padding=UDim.new(0,5)
    L.Parent=page

    local P=Instance.new("UIPadding")
    P.PaddingRight=UDim.new(0,6)
    P.PaddingBottom=UDim.new(0,8)
    P.Parent=page

    Pages[name]={btn=btn,page=page}

    btn.MouseButton1Click:Connect(function()
        for _,p in pairs(Pages) do
            p.page.Visible=false
            TweenService:Create(p.btn,TweenInfo.new(0.12),{
                BackgroundColor3=BG_ROW,
                TextColor3=TXT_DIM
            }):Play()
        end

        page.Visible=true

        TweenService:Create(btn,TweenInfo.new(0.12),{
            BackgroundColor3=ACCENT,
            TextColor3=BG_MAIN
        }):Play()
    end)

    btn.MouseEnter:Connect(function()
        if Pages[name] and Pages[name].page.Visible then return end
        TweenService:Create(btn,TweenInfo.new(0.12),{
            BackgroundColor3=BG_ROW_HOV
        }):Play()
    end)

    btn.MouseLeave:Connect(function()
        if Pages[name] and Pages[name].page.Visible then return end
        TweenService:Create(btn,TweenInfo.new(0.12),{
            BackgroundColor3=BG_ROW
        }):Play()
    end)

    return page
end

local function activatePage(name)
    for _,p in pairs(Pages) do
        p.page.Visible=false
        TweenService:Create(p.btn,TweenInfo.new(0.12),{
            BackgroundColor3=BG_ROW,
            TextColor3=TXT_DIM
        }):Play()
    end

    Pages[name].page.Visible=true

    TweenService:Create(Pages[name].btn,TweenInfo.new(0.12),{
        BackgroundColor3=ACCENT,
        TextColor3=BG_MAIN
    }):Play()
end

