ESPCache={}

local function cleanupESP(plr)
    local e=ESPCache[plr]

    if not e then return end

    if e.highlight then
        e.highlight:Destroy()
    end

    if e.bb then
        e.bb:Destroy()
    end

    ESPCache[plr]=nil
end

spawn(function()
    while true do
        RunService.RenderStepped:Wait()

        if not Config.ESP and not Config.Chams then
            for plr,_ in pairs(ESPCache) do
                cleanupESP(plr)
            end
        else
            for _,plr in ipairs(Players:GetPlayers()) do
                if plr~=LocalPlayer and plr.Character then
                    local e=ESPCache[plr]

                    if not e then
                        e={}
                        ESPCache[plr]=e
                    end

                    if Config.Chams and not e.highlight then
                        local hl=Instance.new("Highlight")
                        hl.FillColor=ACCENT
                        hl.OutlineColor=Color3.fromRGB(255,255,255)
                        hl.FillTransparency=0.5
                        hl.OutlineTransparency=0
                        hl.Adornee=plr.Character
                        hl.Parent=ScreenGui
                        e.highlight=hl
                    elseif not Config.Chams and e.highlight then
                        e.highlight:Destroy()
                        e.highlight=nil
                    end

                    if Config.ESP and not e.bb then
                        local bb=Instance.new("BillboardGui")
                        bb.Size=UDim2.new(0,110,0,26)
                        bb.StudsOffset=Vector3.new(0,2.5,0)
                        bb.AlwaysOnTop=true
                        bb.Parent=ScreenGui

                        local tl=Instance.new("TextLabel")
                        tl.Size=UDim2.new(1,0,1,0)
                        tl.BackgroundTransparency=1
                        tl.TextColor3=ACCENT
                        tl.TextStrokeTransparency=0
                        tl.TextStrokeColor3=Color3.fromRGB(0,0,0)
                        tl.Font=Enum.Font.GothamBold
                        tl.TextSize=12
                        tl.Text=plr.Name
                        tl.Parent=bb

                        e.bb=bb
                        e.bbText=tl
                    elseif not Config.ESP and e.bb then
                        e.bb:Destroy()
                        e.bb=nil
                        e.bbText=nil
                    end

                    if e.highlight then
                        e.highlight.Adornee=plr.Character
                    end

                    if e.bb then
                        local head=plr.Character:FindFirstChild("Head")
                        local hrp=plr.Character:FindFirstChild("HumanoidRootPart")

                        e.bb.Adornee=head or hrp

                        if e.bbText and hrp then
                            local dist=math.floor(
                                (hrp.Position-workspace.CurrentCamera.CFrame.Position).Magnitude
                            )

                            e.bbText.Text=string.format(
                                "%s [%d]",
                                plr.Name,
                                dist
                            )
                        end
                    end
                end
            end
        end
    end
end)

local tracers={}

spawn(function()
    while true do
        RunService.RenderStepped:Wait()

        if Config.Tracers and Drawing then
            local cam=workspace.CurrentCamera

            for _,plr in ipairs(Players:GetPlayers()) do
                if plr~=LocalPlayer and plr.Character then
                    local hrp=plr.Character:FindFirstChild("HumanoidRootPart")

                    if hrp then
                        if not tracers[plr] then
                            local line=Drawing.new("Line")
                            line.Thickness=1
                            line.Color=ACCENT
                            line.Transparency=1
                            tracers[plr]=line
                        end

                        local line=tracers[plr]
                        local pos,on=cam:WorldToViewportPoint(hrp.Position)

                        line.From=Vector2.new(
                            cam.ViewportSize.X/2,
                            cam.ViewportSize.Y
                        )

                        line.To=Vector2.new(pos.X,pos.Y)
                        line.Visible=on
                    end
                end
            end

            for plr,line in pairs(tracers) do
                if not plr.Parent or not plr.Character or not Config.Tracers then
                    line:Remove()
                    tracers[plr]=nil
                end
            end
        elseif Drawing then
            for plr,line in pairs(tracers) do
                line:Remove()
                tracers[plr]=nil
            end
        end
    end
end)

