    lbl.TextColor3=TXT
    lbl.TextXAlignment=Enum.TextXAlignment.Left
    lbl.Font=Enum.Font.Gotham
    lbl.TextSize=11
    lbl.Parent=row

    local btn=Instance.new("TextButton")
    btn.Size=UDim2.new(0,36,0,18)
    btn.Position=UDim2.new(1,-46,0.5,-9)
    btn.Text=""
    btn.BorderSizePixel=0
    btn.AutoButtonColor=false
    btn.Parent=row
    Instance.new("UICorner",btn).CornerRadius=UDim.new(1,0)

    local knob=Instance.new("Frame")
    knob.Size=UDim2.new(0,14,0,14)
    knob.BorderSizePixel=0
    knob.Parent=btn
    Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)

    local state=default

    local function render(animate)
        local on=state

        local target={
            BackgroundColor3=on and ACCENT or BG_BTN
        }

        local knobTarget={
            Position=on and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7),
            BackgroundColor3=on and BG_MAIN or Color3.fromRGB(210,210,210)
        }

        if animate then
            TweenService:Create(btn,TweenInfo.new(0.14),target):Play()
            TweenService:Create(knob,TweenInfo.new(0.14),knobTarget):Play()
        else
            btn.BackgroundColor3=target.BackgroundColor3
            knob.Position=knobTarget.Position
            knob.BackgroundColor3=knobTarget.BackgroundColor3
        end
    end

    render(false)

    local function set(v,skipAnim)
        state=v
        render(not skipAnim)
        if cb then cb(v) end
    end

    btn.MouseButton1Click:Connect(function()
        set(not state)
    end)

    local api={
        set=function(v) set(v,true) end,
        get=function() return state end
    }

    if key then Registry[key]=api end

    return api
end

local function makeSlider(parent,key,label,min,max,default,decimals,cb)
    local row=Instance.new("Frame")
    row.Size=UDim2.new(1,0,0,40)
    row.BackgroundColor3=BG_ROW
    row.BorderSizePixel=0
    row.Parent=parent
    Instance.new("UICorner",row).CornerRadius=UDim.new(0,5)

    local lbl=Instance.new("TextLabel")
    lbl.Size=UDim2.new(1,-70,0,16)
    lbl.Position=UDim2.new(0,10,0,5)
    lbl.BackgroundTransparency=1
    lbl.Text=label
    lbl.TextColor3=TXT
    lbl.TextXAlignment=Enum.TextXAlignment.Left
    lbl.Font=Enum.Font.Gotham
    lbl.TextSize=11
    lbl.Parent=row

    local valLbl=Instance.new("TextLabel")
    valLbl.Size=UDim2.new(0,60,0,16)
    valLbl.Position=UDim2.new(1,-70,0,5)
    valLbl.BackgroundTransparency=1
    valLbl.TextColor3=ACCENT
    valLbl.TextXAlignment=Enum.TextXAlignment.Right
    valLbl.Font=Enum.Font.GothamBold
    valLbl.TextSize=11
    valLbl.Parent=row

    local bar=Instance.new("Frame")
    bar.Size=UDim2.new(1,-20,0,5)
    bar.Position=UDim2.new(0,10,0,28)
    bar.BackgroundColor3=BG_BTN
    bar.BorderSizePixel=0
    bar.Parent=row
    Instance.new("UICorner",bar).CornerRadius=UDim.new(1,0)

    local fill=Instance.new("Frame")
    fill.Size=UDim2.new(0,0,1,0)
    fill.BackgroundColor3=ACCENT
    fill.BorderSizePixel=0
    fill.Parent=bar
    Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)

    local thumb=Instance.new("Frame")
    thumb.Size=UDim2.new(0,11,0,11)
    thumb.BackgroundColor3=ACCENT
    thumb.BorderSizePixel=0
    thumb.Parent=bar
    Instance.new("UICorner",thumb).CornerRadius=UDim.new(1,0)

    local thumbStroke=Instance.new("UIStroke")
    thumbStroke.Color=BG_MAIN
    thumbStroke.Thickness=1
    thumbStroke.Parent=thumb

    local mult=10^decimals
    local value=default

    local function fmt(v)
        if decimals==0 then
            return tostring(math.floor(v))
        end
        return string.format("%."..decimals.."f",v)
    end

    local function render()
        local pct=(value-min)/(max-min)
        fill.Size=UDim2.new(pct,0,1,0)
        thumb.Position=UDim2.new(pct,-5.5,0.5,-5.5)
        valLbl.Text=fmt(value)
    end

    local dragging=false

    local function updateFromX(x)
        local rel=math.clamp(
            (x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,
            0,
            1
        )

        value=math.floor(
            (min+(max-min)*rel)*mult+0.5
        )/mult

        render()

        if cb then cb(value) end
    end

    bar.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then
            dragging=true
            updateFromX(i.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
            updateFromX(i.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then
            dragging=false
        end
    end)

    render()

    local function set(v)
        value=math.clamp(v,min,max)
        render()
        if cb then cb(value) end
    end

    local api={
        set=set,
        get=function() return value end
    }

    if key then Registry[key]=api end

    return api
end

