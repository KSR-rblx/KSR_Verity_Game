local savedFOV=nil
local fovConn=nil
local applyingFOV=false

local function applyFOV()
    local cam=workspace.CurrentCamera

    if not cam then return end

    if cam.FieldOfView~=Config.FOV then
        applyingFOV=true
        cam.FieldOfView=Config.FOV
        applyingFOV=false
    end
end

local function startFOV()
    local cam=workspace.CurrentCamera

    if not cam then return end

    applyFOV()

    if fovConn then
        fovConn:Disconnect()
    end

    fovConn=cam:GetPropertyChangedSignal("FieldOfView"):Connect(function()
        if applyingFOV then return end
        if not Config.FOVEnabled then return end

        if cam.FieldOfView~=Config.FOV then
            applyFOV()
        end
    end)
end

local function stopFOV()
    if fovConn then
        fovConn:Disconnect()
        fovConn=nil
    end
end

